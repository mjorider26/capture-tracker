{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "capture-tracker-production-document-scanner",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "secrets": { "required": ["CAPTURE_TRACKER_DOCUMENT_SCANNER_INTERNAL_TOKEN"] },
  "workers_dev": false,
  "services": [{ "binding": "CAPTURE_TRACKER_APP", "service": "capture-tracker-production" }],
  "containers": [{ "class_name": "DocumentScannerContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "standard-1" }],
  "durable_objects": { "bindings": [{ "name": "CAPTURE_TRACKER_DOCUMENT_SCANNER", "class_name": "DocumentScannerContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentScannerContainer"] }],
  "queues": { "consumers": [{ "queue": "capture-tracker-production-document-scan", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "retry_delay": 30, "dead_letter_queue": "capture-tracker-production-document-scan-dlq" }] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
