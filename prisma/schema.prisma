model ApprovalDecision {
  id                    String         @id @default(cuid())
  businessId            String
  status                ApprovalStatus @default(PENDING)
  reviewerMembershipId  String?
  decidedAt             DateTime?
  reason                String?
  expectedEntityVersion Int
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  version               Int            @default(1)

  reimbursementClaimId   String?
  payrollRunId           String?
  ownerDistributionId    String?
  quarterlyTaxEstimateId String?
  aiRecommendationId     String?

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reviewerMembership   BusinessMember?       @relation("ApprovalReviewerMembership", fields: [businessId, reviewerMembershipId], references: [businessId, userId], onDelete: Restrict)
  reimbursementClaim   ReimbursementClaim?   @relation("ReimbursementApprovals", fields: [businessId, reimbursementClaimId], references: [businessId, id], onDelete: Restrict)
  payrollRun           PayrollRun?           @relation("PayrollApprovals", fields: [businessId, payrollRunId], references: [businessId, id], onDelete: Restrict)
  ownerDistribution    OwnerDistribution?    @relation("DistributionApprovals", fields: [businessId, ownerDistributionId], references: [businessId, id], onDelete: Restrict)
  quarterlyTaxEstimate QuarterlyTaxEstimate? @relation("TaxEstimateApprovals", fields: [businessId, quarterlyTaxEstimateId], references: [businessId, id], onDelete: Restrict)
  aiRecommendation     AIRecommendation?     @relation("AIRecommendationApprovals", fields: [businessId, aiRecommendationId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, reviewerMembershipId])
}

model LedgerAccount {
  id                 String               @id @default(cuid())
  businessId         String
  code               String
  name               String
  description        String?
  type               LedgerAccountType
  subtype            LedgerAccountSubtype
  normalBalance      NormalBalance
  isSystem           Boolean              @default(false)
  isActive           Boolean              @default(true)
  financialAccountId String?
  parentAccountId    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  version            Int                  @default(1)

  business           Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount? @relation("FinancialAccountLedgerAccount", fields: [businessId, financialAccountId], references: [businessId, id], onDelete: Restrict)
  parentAccount      LedgerAccount?    @relation("LedgerAccountHierarchy", fields: [businessId, parentAccountId], references: [businessId, id], onDelete: Restrict)
  childAccounts      LedgerAccount[]   @relation("LedgerAccountHierarchy")
  journalLines       JournalLine[]
  debitPostingRules  PostingRule[]     @relation("PostingRuleDebitAccount")
  creditPostingRules PostingRule[]     @relation("PostingRuleCreditAccount")

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@unique([businessId, financialAccountId])
  @@index([businessId, type, isActive])
  @@index([businessId, parentAccountId])
}

model AccountingPeriod {
