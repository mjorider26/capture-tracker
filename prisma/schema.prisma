model User {
  id            String   @id @default(cuid())
  email         String   @unique
  displayName   String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  memberships BusinessMember[]
  sessions    Session[]
  accounts    Account[]
}

model Business {
  id                   String   @id @default(cuid())
  legalName            String
  displayName          String
  einLastFour          String?
  taxElection          String   @default("S_CORP")
  fiscalYearStartMonth Int      @default(1)
  timezone             String   @default("America/Los_Angeles")
  currency             String   @default("USD")
  /// Presentation-only designation. It is never used for authorization or accounting.
  customerExperience   String   @default("STANDARD") @db.VarChar(32)
  cpaDocumentAccess    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  version              Int      @default(1)

  members                    BusinessMember[]
  accounts                   FinancialAccount[]
  transactions               Transaction[]
  documents                  Document[]
  documentStatusHistory      DocumentStatusHistory[]
  transactionDocuments       TransactionDocument[]
  transactionDocumentHistory TransactionDocumentHistory[]
  documentExtractionAttempts DocumentExtractionAttempt[]
  documentExtractionHistory  DocumentExtractionHistory[]
  documentMatchRuns          DocumentMatchRun[]
  documentMatchSuggestions   DocumentMatchSuggestion[]
  documentMatchHistory       DocumentMatchHistory[]
  auditEvents                AuditEvent[]
  reimbursementClaims        ReimbursementClaim[]
  reimbursementExpenses      ReimbursementExpense[]
  ownerMoneyTransfers        OwnerMoneyTransfer[]
  payrollRuns                PayrollRun[]
  payrollMatches             PayrollBankMatch[]
  reasonableCompWorkpapers   ReasonableCompWorkpaper[]
  fixedAssets                FixedAsset[]
  monthEndCloses             MonthEndClose[]
  ownerDistributions         OwnerDistribution[]
  quarterlyTaxEstimates      QuarterlyTaxEstimate[]
  taxPaymentRecords          TaxPaymentRecord[]
  weeklyReviews              WeeklyReview[]
  weeklyReviewHistory        WeeklyReviewHistory[]
  askAiConversations         AskAiConversation[]
  askAiMessages              AskAiMessage[]
  askAiRuns                  AskAiRun[]
  askAiEvidence              AskAiEvidence[]
  askAiFeedback              AskAiFeedback[]
  askAiEvents                AskAiEvent[]
  onboarding                 BusinessOnboarding?
  cutover                    BusinessCutover?
  settings                   BusinessSettings?
  settingsHistory            BusinessSettingsHistory[]
  exportAudits               ExportAudit[]
  aiRecommendations          AIRecommendation[]
  approvalDecisions          ApprovalDecision[]
  ledgerAccounts             LedgerAccount[]
  journalEntries             JournalEntry[]
  journalLines               JournalLine[]
  accountingPeriods          AccountingPeriod[]
  reconciliations            Reconciliation[]
  reconciliationItems        ReconciliationItem[]
  statementActivities        StatementActivity[]
  statementActivityDecisions StatementActivityCandidateDecision[]
  postingRules               PostingRule[]
  transactionImports         TransactionImport[]
  transactionImportProfiles  TransactionImportProfile[]
  externalTransactions       ExternalTransaction[]
  merchantCategoryRules      MerchantCategoryRule[]
  shareholderBasisWorkpapers ShareholderBasisWorkpaper[]
  shareholderBasisAdjustments ShareholderBasisAdjustment[]
  shareholderDebtInstruments ShareholderDebtInstrument[]
  distributionReadinessSnapshots DistributionReadinessSnapshot[]
  accountingPolicies         AccountingPolicy[]
  accountingPolicyVersions   AccountingPolicyVersion[]
  accountingPolicyApplications AccountingPolicyApplication[]
  shareholderBenefitWorkpapers ShareholderBenefitWorkpaper[]
  bankConnections              BankConnection[]
  connectedFinancialAccounts   ConnectedFinancialAccount[]
  bankSyncRuns                 BankSyncRun[]
  bankProviderTransactions     BankProviderTransaction[]
  customers                    Customer[]
  invoices                     Invoice[]
  invoicePayments              InvoicePayment[]
  cpaInvitations               CpaInvitation[]
  vendors                      Vendor[]
  bills                        Bill[]
  billPayments                 BillPayment[]
  mileagePolicies              MileagePolicy[]
  mileageTrips                 MileageTrip[]

  @@index([legalName])
}

/// Tax workpaper facts only. A missing opening basis deliberately remains null, never zero.
model ShareholderBasisWorkpaper {
  id                   String   @id @default(cuid())
  businessId           String
  taxYear              Int
  openingStockBasis    Decimal? @db.Decimal(18, 2)
  openingDebtBasis     Decimal? @db.Decimal(18, 2)
  effectiveDate        DateTime?
  sourceReference      String?  @db.VarChar(500)
  notes                String?
  enteredByUserId      String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  ownerConfirmedByUserId String?
  ownerConfirmedAt     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  version              Int      @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  adjustments ShareholderBasisAdjustment[]

  @@unique([businessId, taxYear])
  @@index([businessId, taxYear])
}

/// Explicit owner/CPA-entered Form 7203-support lines; this is not a tax-return calculator.
model ShareholderBasisAdjustment {
  id          String   @id @default(cuid())
  businessId  String
  workpaperId String
  taxYear     Int
  category    String   @db.VarChar(64)
  amount      Decimal  @db.Decimal(18, 2)
  source      String   @db.VarChar(500)
  documentReference String? @db.VarChar(500)
  confirmedByUserId String?
  confirmedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  workpaper ShareholderBasisWorkpaper @relation(fields: [workpaperId], references: [id], onDelete: Restrict)

  @@index([businessId, taxYear])
  @@index([workpaperId, createdAt])
}

/// A distinct shareholder note/open-account fact. It is not inferred from generic liabilities.
model ShareholderDebtInstrument {
  id                 String   @id @default(cuid())
  businessId         String
  loanDate           DateTime
  label              String   @db.VarChar(180)
  originalPrincipal  Decimal  @db.Decimal(18, 2)
  outstandingPrincipal Decimal @db.Decimal(18, 2)
  taxBasisAmount     Decimal? @db.Decimal(18, 2)
  writtenNoteReference String? @db.VarChar(500)
  accountingReference String? @db.VarChar(500)
  cpaNotes           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  version            Int      @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, loanDate])
}

/// Immutable factual/workpaper warning snapshot captured when a distribution is reviewed.
model DistributionReadinessSnapshot {
  id                   String   @id @default(cuid())
  businessId           String
  ownerDistributionId  String?
  status               String   @db.VarChar(48)
  snapshotJson         Json
  acknowledgedAt       DateTime?
  createdAt            DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  ownerDistribution OwnerDistribution? @relation(fields: [businessId, ownerDistributionId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@unique([businessId, ownerDistributionId])
}

model AccountingPolicy {
  id           String   @id @default(cuid())
  businessId   String
  policyType   String   @db.VarChar(64)
  title        String   @db.VarChar(180)
  currentVersionId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  versions AccountingPolicyVersion[] @relation("PolicyVersions")
  currentVersion AccountingPolicyVersion? @relation("PolicyCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)

  @@unique([businessId, policyType])
}

model AccountingPolicyVersion {
  id          String   @id @default(cuid())
  businessId  String
  policyId    String
  effectiveDate DateTime
  content     String
  reason      String?
  changedByUserId String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  policy AccountingPolicy @relation("PolicyVersions", fields: [policyId], references: [id], onDelete: Restrict)
  currentFor AccountingPolicy? @relation("PolicyCurrentVersion")
  applications AccountingPolicyApplication[]

  @@index([businessId, effectiveDate])
  @@index([policyId, effectiveDate])
}

/// Historical reference from a consequential workflow to the policy version in force when it was performed.
model AccountingPolicyApplication {
  id              String   @id @default(cuid())
  businessId      String
  policyVersionId String
  entityType      String   @db.VarChar(64)
  entityId        String
  appliedAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  policyVersion AccountingPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([businessId, policyVersionId, entityType, entityId])
  @@index([businessId, entityType, entityId])
}

/// Factual greater-than-2% shareholder health-insurance workpaper; no deduction conclusion is stored.
model ShareholderBenefitWorkpaper {
  id                 String   @id @default(cuid())
  businessId         String
  taxYear            Int
  benefitType        String   @db.VarChar(64)
  provider           String?  @db.VarChar(180)
  coverageStart      DateTime?
  coverageEnd        DateTime?
  premiumAmount      Decimal? @db.Decimal(18, 2)
  paymentMethod      String?  @db.VarChar(64)
  payrollInclusionStatus String @default("INCOMPLETE") @db.VarChar(48)
  w2WorkpaperStatus  String   @default("INCOMPLETE") @db.VarChar(48)
  documentReference  String?  @db.VarChar(500)
  cpaReviewStatus    String   @default("CPA_REVIEW") @db.VarChar(48)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  version            Int      @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, taxYear])
}

/// A private, operator-created invitation. Only the one-way token hash is persisted.
model OperatorInvitation {
  id                  String                   @id @default(cuid())
  invitedEmail        String                   @db.VarChar(320)
  ownerDisplayName    String                   @db.VarChar(120)
  businessLegalName   String                   @db.VarChar(160)
  businessDisplayName String                   @db.VarChar(160)
  /// Carries a presentation-only designation into the new workspace.
  customerExperience  String                   @default("STANDARD") @db.VarChar(32)
  tokenHash           String                   @unique @db.VarChar(64)
  createdByUserId     String
  acceptedByUserId    String?
  provisionedBusinessId String?                @unique
  status              OperatorInvitationStatus @default(PENDING)
  createdAt           DateTime                 @default(now())
  expiresAt           DateTime
  acceptedAt          DateTime?
  revokedAt           DateTime?
  emailDeliveryStatus String                   @default("MANUAL_REQUIRED") @db.VarChar(32)
  emailDeliveryAttemptedAt DateTime?
  emailDeliveryError  String?                  @db.VarChar(200)
  version             Int                      @default(1)

  @@index([invitedEmail, status, expiresAt])
  @@index([createdByUserId, status, createdAt])
}

model ProductionBootstrap {
  id             String   @id
  ownerEmailHash String
  userId         String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  version    Int          @default(1)

  business                     Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedTransactions         Transaction[]                 @relation("TransactionApproverMembership")
  uploadedDocuments            Document[]                    @relation("DocumentUploaderMembership")
  documentStatusHistory        DocumentStatusHistory[]       @relation("DocumentStatusHistoryActor")
  auditEvents                  AuditEvent[]                  @relation("AuditActorMembership")
  reimbursementClaims          ReimbursementClaim[]          @relation("ReimbursementClaimantMembership")
  approvalDecisions            ApprovalDecision[]            @relation("ApprovalReviewerMembership")
  linkedTransactionDocuments   TransactionDocument[]         @relation("TransactionDocumentLinkedBy")
  unlinkedTransactionDocuments TransactionDocument[]         @relation("TransactionDocumentUnlinkedBy")
  transactionDocumentHistory   TransactionDocumentHistory[]  @relation("TransactionDocumentHistoryActor")
  requestedDocumentExtractions DocumentExtractionAttempt[]   @relation("DocumentExtractionRequestedBy")
  reviewedDocumentCandidates   DocumentExtractionCandidate[] @relation("DocumentExtractionReviewedBy")
  documentExtractionHistory    DocumentExtractionHistory[]   @relation("DocumentExtractionHistoryActor")
  requestedDocumentMatchRuns   DocumentMatchRun[]            @relation("DocumentMatchRequestedBy")
  documentMatchHistory         DocumentMatchHistory[]        @relation("DocumentMatchHistoryActor")
  startedWeeklyReviews         WeeklyReview[]                @relation("WeeklyReviewStartedBy")
  completedWeeklyReviews       WeeklyReview[]                @relation("WeeklyReviewCompletedBy")
  weeklyReviewHistory          WeeklyReviewHistory[]         @relation("WeeklyReviewHistoryActor")
  askAiConversations           AskAiConversation[]           @relation("AskAiConversationActor")
  askAiMessages                AskAiMessage[]                @relation("AskAiMessageActor")
  askAiRuns                    AskAiRun[]                    @relation("AskAiRunActor")
  askAiFeedback                AskAiFeedback[]               @relation("AskAiFeedbackActor")
  askAiEvents                  AskAiEvent[]                  @relation("AskAiEventActor")
  onboardingChanges            BusinessOnboarding[]          @relation("BusinessOnboardingActor")
  settingsChanges              BusinessSettingsHistory[]     @relation("BusinessSettingsHistoryActor")
  exportAudits                 ExportAudit[]                 @relation("ExportAuditActor")

  @@unique([businessId, userId])
  @@index([userId])
}

model FinancialAccount {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  institutionName String?
  type            AccountType
  ownership       AccountOwnership
  lastFour        String?
  isTaxReserve    Boolean          @default(false)
  isActive        Boolean          @default(true)
  openingBalance  Decimal          @default(0) @db.Decimal(18, 2)
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  version         Int              @default(1)

  business                   Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transactions               Transaction[]
  reimbursementAccounts      ReimbursementClaim[]       @relation("ReimbursementPaymentAccount")
  distributionSourceAccounts OwnerDistribution[]        @relation("DistributionSourceAccount")
  ledgerAccount              LedgerAccount?             @relation("FinancialAccountLedgerAccount")
  reconciliations            Reconciliation[]
  transactionImports         TransactionImport[]
  transactionImportProfiles  TransactionImportProfile[]
  externalTransactions       ExternalTransaction[]
  merchantCategoryRules      MerchantCategoryRule[]
  connectedFinancialAccounts ConnectedFinancialAccount[]

  @@unique([businessId, id])
  @@index([businessId, isActive])
  @@index([businessId, type])
}

model Transaction {
  id                          String               @id @default(cuid())
  businessId                  String
  accountId                   String
  postedAt                    DateTime
  description                 String
  merchantName                String?
  amount                      Decimal              @db.Decimal(18, 2)
  direction                   TransactionDirection
  intent                      TransactionIntent    @default(UNREVIEWED)
  status                      TransactionStatus    @default(PENDING_REVIEW)
  sourceReference             String?
  manualEntryKey              String?
  correctionKey               String?
  correctionReason            String?
  correctionOfId              String?
  correctionReversalJournalId String?
  notes                       String?
  approvedAt                  DateTime?
  approvedByMembershipId      String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  voidedAt                    DateTime?
  version                     Int                  @default(1)

  business                            Business                             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account                             FinancialAccount                     @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)
  approvedByMembership                BusinessMember?                      @relation("TransactionApproverMembership", fields: [businessId, approvedByMembershipId], references: [businessId, userId], onDelete: Restrict)
  splits                              TransactionSplit[]
  documents                           TransactionDocument[]
  matchSuggestions                    DocumentMatchSuggestion[]
  reimbursementPayments               ReimbursementClaim[]                 @relation("ReimbursementPaymentTransaction")
  reimbursementExpenses               ReimbursementExpense[]               @relation("ReimbursementExpenseTransaction")
  distributions                       OwnerDistribution[]                  @relation("DistributionTransaction")
  journalEntry                        JournalEntry?                        @relation("TransactionJournalEntry")
  reconciliationItems                 ReconciliationItem[]
  matchedStatementActivities          StatementActivity[]                  @relation("StatementActivityMatchedTransaction")
  statementActivityCandidateDecisions StatementActivityCandidateDecision[] @relation("StatementActivityCandidateTransaction")
  correctionOf                        Transaction?                         @relation("TransactionCorrections", fields: [businessId, correctionOfId], references: [businessId, id], onDelete: Restrict)
  corrections                         Transaction[]                        @relation("TransactionCorrections")
  correctionReversalJournal           JournalEntry?                        @relation("TransactionCorrectionReversal", fields: [businessId, correctionReversalJournalId], references: [businessId, id], onDelete: Restrict)
  externalTransaction                 ExternalTransaction?                 @relation("ExternalTransactionPostedTransaction")
  fixedAssetSources                   FixedAsset[]                         @relation("FixedAssetTransactionSource")

  @@unique([businessId, id])
  @@unique([accountId, sourceReference])
  @@unique([businessId, manualEntryKey])
  @@unique([businessId, correctionKey])
  @@unique([businessId, correctionOfId])
  @@unique([businessId, correctionReversalJournalId])
  @@index([businessId, postedAt])
  @@index([businessId, status])
  @@index([businessId, intent])
  @@index([businessId, accountId, postedAt])
}

/// A persisted import contains safe mapping and outcome evidence, never the source CSV itself.
model TransactionImport {
  id                     String                  @id @default(cuid())
  businessId             String
  financialAccountId     String
  createdByUserId        String
  profileId              String?
  sourceFilename         String
  sourceSha256           String
  mappingJson            Json
  rowCount               Int                     @default(0)
  newCount               Int                     @default(0)
  duplicateCount         Int                     @default(0)
  possibleDuplicateCount Int                     @default(0)
  invalidCount           Int                     @default(0)
  status                 TransactionImportStatus @default(UPLOADED)
  confirmedAt            DateTime?
  completedAt            DateTime?
  failureReason          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  version                Int                     @default(1)

  business             Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccount     FinancialAccount          @relation(fields: [businessId, financialAccountId], references: [businessId, id], onDelete: Restrict)
  profile              TransactionImportProfile? @relation(fields: [businessId, profileId], references: [businessId, id], onDelete: Restrict)
  externalTransactions ExternalTransaction[]

  @@unique([businessId, id])
  @@index([businessId, status, createdAt])
  @@index([businessId, financialAccountId, createdAt])
}

model TransactionImportProfile {
  id                 String   @id @default(cuid())
  businessId         String
  financialAccountId String
  name               String
  sourceSignature    String
  mappingJson        Json
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
