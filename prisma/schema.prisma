  @@unique([businessId, id])
  @@index([businessId, tripDate])
  @@index([businessId, reimbursementClaimId])
}

/// Cutover facts are bookkeeping inputs, not a QuickBooks replica or tax conclusion.
model BusinessCutover {
  id              String   @id @default(cuid())
  businessId      String   @unique
  startDate       DateTime
  sourceReference String?  @db.VarChar(300)
  openingJournalId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
}

model BusinessSettings {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  defaultReportPeriod String   @default("month") @db.VarChar(24)
  weeklyReviewDay     Int      @default(1)
  retentionMonths     Int      @default(84)
  updatedAt           DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, id])
}

model BusinessSettingsHistory {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String
  changedJson Json
  createdAt   DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor    BusinessMember @relation("BusinessSettingsHistoryActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, createdAt])
}

model ExportAudit {
  id          String     @id @default(cuid())
  businessId  String
  actorUserId String
  kind        ExportKind
  rowCount    Int
  manifest    Json
  createdAt   DateTime   @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor    BusinessMember @relation("ExportAuditActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, createdAt])
}

model ReviewTask {
  id             String             @id @default(cuid())
  businessId     String
  weeklyReviewId String
  title          String
  explanation    String?
  category       ReviewTaskCategory
  status         ReviewStatus       @default(OPEN)
  priority       ReviewTaskPriority @default(MEDIUM)
  sourceType     String?
  sourceEntityId String?
  sortOrder      Int                @default(0)
  completedAt    DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  version        Int                @default(1)

  weeklyReview WeeklyReview @relation(fields: [businessId, weeklyReviewId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, weeklyReviewId, status])
  @@index([businessId, priority])
}

model AIRecommendation {
  id                  String                 @id @default(cuid())
  businessId          String
  type                AIRecommendationType
  status              AIRecommendationStatus @default(PENDING_REVIEW)
  sourceEntityType    String?
  sourceEntityId      String?
  title               String
  explanation         String
  proposedChangeJson  Json
  supportingFactsJson Json?
  modelProvider       String
  modelName           String
  promptVersion       String
  expiresAt           DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  version             Int                    @default(1)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  approvals ApprovalDecision[] @relation("AIRecommendationApprovals")

  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, type])
  @@index([businessId, sourceEntityType, sourceEntityId])
}

model ApprovalDecision {
  id                    String         @id @default(cuid())
  businessId            String
  status                ApprovalStatus @default(PENDING)
  reviewerMembershipId  String?
  decidedAt             DateTime?
  reason                String?
  expectedEntityVersion Int
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  version               Int            @default(1)

  reimbursementClaimId   String?
  payrollRunId           String?
  ownerDistributionId    String?
  quarterlyTaxEstimateId String?
  aiRecommendationId     String?

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reviewerMembership   BusinessMember?       @relation("ApprovalReviewerMembership", fields: [businessId, reviewerMembershipId], references: [businessId, userId], onDelete: Restrict)
  reimbursementClaim   ReimbursementClaim?   @relation("ReimbursementApprovals", fields: [businessId, reimbursementClaimId], references: [businessId, id], onDelete: Restrict)
  payrollRun           PayrollRun?           @relation("PayrollApprovals", fields: [businessId, payrollRunId], references: [businessId, id], onDelete: Restrict)
  ownerDistribution    OwnerDistribution?    @relation("DistributionApprovals", fields: [businessId, ownerDistributionId], references: [businessId, id], onDelete: Restrict)
  quarterlyTaxEstimate QuarterlyTaxEstimate? @relation("TaxEstimateApprovals", fields: [businessId, quarterlyTaxEstimateId], references: [businessId, id], onDelete: Restrict)
  aiRecommendation     AIRecommendation?     @relation("AIRecommendationApprovals", fields: [businessId, aiRecommendationId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, reviewerMembershipId])
}

model LedgerAccount {
  id                 String               @id @default(cuid())
  businessId         String
  code               String
  name               String
  description        String?
  type               LedgerAccountType
  subtype            LedgerAccountSubtype
  normalBalance      NormalBalance
  isSystem           Boolean              @default(false)
  isActive           Boolean              @default(true)
  financialAccountId String?
  parentAccountId    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  version            Int                  @default(1)

  business                      Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccount              FinancialAccount?      @relation("FinancialAccountLedgerAccount", fields: [businessId, financialAccountId], references: [businessId, id], onDelete: Restrict)
  parentAccount                 LedgerAccount?         @relation("LedgerAccountHierarchy", fields: [businessId, parentAccountId], references: [businessId, id], onDelete: Restrict)
  childAccounts                 LedgerAccount[]        @relation("LedgerAccountHierarchy")
  journalLines                  JournalLine[]
  debitPostingRules             PostingRule[]          @relation("PostingRuleDebitAccount")
  creditPostingRules            PostingRule[]          @relation("PostingRuleCreditAccount")
  suggestedExternalTransactions ExternalTransaction[]  @relation("ExternalTransactionSuggestedAccount")
  reviewedExternalTransactions  ExternalTransaction[]  @relation("ExternalTransactionReviewAccount")
  merchantCategoryRules         MerchantCategoryRule[]

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@unique([businessId, financialAccountId])
  @@index([businessId, type, isActive])
  @@index([businessId, parentAccountId])
}

model AccountingPeriod {
  id                   String                 @id @default(cuid())
  businessId           String
  startsAt             DateTime
  endsAt               DateTime
  status               AccountingPeriodStatus @default(OPEN)
  lockedAt             DateTime?
  lockedByMembershipId String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  version              Int                    @default(1)

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([businessId, id])
  @@unique([businessId, startsAt, endsAt])
  @@index([businessId, status])
}

model JournalEntry {
  id                     String                 @id @default(cuid())
  businessId             String
  accountingPeriodId     String
  entryNumber            String
  entryDate              DateTime
  description            String
  status                 JournalEntryStatus     @default(DRAFT)
  sourceType             JournalEntrySourceType
  sourceEntityId         String?
  transactionId          String?
  reimbursementClaimId   String?
  payrollRunId           String?
  ownerDistributionId    String?
  taxPaymentRecordId     String?
  reversalOfEntryId      String?
  postedAt               DateTime?
  reversedAt             DateTime?
  approvedByMembershipId String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  version                Int                    @default(1)

  business              Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  accountingPeriod      AccountingPeriod    @relation(fields: [businessId, accountingPeriodId], references: [businessId, id], onDelete: Restrict)
  transaction           Transaction?        @relation("TransactionJournalEntry", fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)
  reimbursementClaim    ReimbursementClaim? @relation("ReimbursementClaimJournalEntry", fields: [businessId, reimbursementClaimId], references: [businessId, id], onDelete: Restrict)
  payrollRun            PayrollRun?         @relation("PayrollRunJournalEntry", fields: [businessId, payrollRunId], references: [businessId, id], onDelete: Restrict)
  ownerDistribution     OwnerDistribution?  @relation("OwnerDistributionJournalEntry", fields: [businessId, ownerDistributionId], references: [businessId, id], onDelete: Restrict)
  taxPaymentRecord      TaxPaymentRecord?   @relation("TaxPaymentJournalEntry", fields: [businessId, taxPaymentRecordId], references: [businessId, id], onDelete: Restrict)
  reversalOfEntry       JournalEntry?       @relation("JournalEntryReversals", fields: [businessId, reversalOfEntryId], references: [businessId, id], onDelete: Restrict)
  reversedByEntries     JournalEntry[]      @relation("JournalEntryReversals")
  lines                 JournalLine[]
  correctionReversalFor Transaction?        @relation("TransactionCorrectionReversal")
  invoiceIssueFor       Invoice?            @relation("InvoiceIssueJournal")
  invoicePaymentFor     InvoicePayment?     @relation("InvoicePaymentJournal")
  billApprovalFor       Bill?               @relation("BillApprovalJournal")
  billPaymentFor        BillPayment?        @relation("BillPaymentJournal")

  @@unique([businessId, id])
  @@unique([businessId, entryNumber])
  @@unique([businessId, transactionId])
  @@unique([businessId, reimbursementClaimId])
  @@unique([businessId, payrollRunId])
  @@unique([businessId, ownerDistributionId])
  @@unique([businessId, taxPaymentRecordId])
  @@unique([businessId, reversalOfEntryId])
  @@index([businessId, entryDate])
  @@index([businessId, status])
  @@index([businessId, sourceType, sourceEntityId])
}

model JournalLine {
  id              String   @id @default(cuid())
  businessId      String
  journalEntryId  String
  ledgerAccountId String
  lineNumber      Int
  memo            String?
  debitAmount     Decimal  @default(0) @db.Decimal(18, 2)
  creditAmount    Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry  @relation(fields: [businessId, journalEntryId], references: [businessId, id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [businessId, ledgerAccountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, journalEntryId, lineNumber])
  @@index([businessId, ledgerAccountId])
}

model PostingRule {
  id                    String                @id @default(cuid())
  businessId            String
  name                  String
  status                PostingRuleStatus     @default(ACTIVE)
  sourceType            PostingRuleSourceType
  sourceSubtype         String?
  debitLedgerAccountId  String
  creditLedgerAccountId String
  priority              Int                   @default(100)
  description           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  version               Int                   @default(1)

  business            Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  debitLedgerAccount  LedgerAccount @relation("PostingRuleDebitAccount", fields: [businessId, debitLedgerAccountId], references: [businessId, id], onDelete: Restrict)
  creditLedgerAccount LedgerAccount @relation("PostingRuleCreditAccount", fields: [businessId, creditLedgerAccountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, sourceType, sourceSubtype, priority])
  @@index([businessId, status])
}

model Reconciliation {
  id                      String               @id @default(cuid())
  businessId              String
  financialAccountId      String
  statementStartDate      DateTime
  statementEndDate        DateTime
  statementOpeningBalance Decimal              @db.Decimal(18, 2)
  statementEndingBalance  Decimal              @db.Decimal(18, 2)
  status                  ReconciliationStatus @default(DRAFT)
  completedAt             DateTime?
  completedByMembershipId String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  version                 Int                  @default(1)

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccount    FinancialAccount     @relation(fields: [businessId, financialAccountId], references: [businessId, id], onDelete: Restrict)
  items               ReconciliationItem[]
  statementActivities StatementActivity[]

  @@unique([businessId, id])
  @@unique([businessId, financialAccountId, statementEndDate])
  @@index([businessId, status])
}

model ReconciliationItem {
  id               String                   @id @default(cuid())
  businessId       String
  reconciliationId String
  transactionId    String
  status           ReconciliationItemStatus @default(OUTSTANDING)
  clearedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  version          Int                      @default(1)

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reconciliation Reconciliation @relation(fields: [businessId, reconciliationId], references: [businessId, id], onDelete: Restrict)
  transaction    Transaction    @relation(fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, reconciliationId, transactionId])
  @@index([businessId, status])
}

model StatementActivity {
  id                   String                  @id @default(cuid())
  businessId           String
  reconciliationId     String
  activityDate         DateTime
  description          String
  reference            String?
  amount               Decimal                 @db.Decimal(18, 2)
  direction            TransactionDirection
  status               StatementActivityStatus @default(UNMATCHED)
  matchedTransactionId String?
  matchedAt            DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  version              Int                     @default(1)

  business           Business                             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reconciliation     Reconciliation                       @relation(fields: [businessId, reconciliationId], references: [businessId, id], onDelete: Restrict)
  matchedTransaction Transaction?                         @relation("StatementActivityMatchedTransaction", fields: [businessId, matchedTransactionId], references: [businessId, id], onDelete: Restrict)
  candidateDecisions StatementActivityCandidateDecision[]

  @@unique([businessId, id])
  @@unique([businessId, matchedTransactionId])
  @@index([businessId, reconciliationId, status])
  @@index([businessId, activityDate])
}

model StatementActivityCandidateDecision {
  id                  String   @id @default(cuid())
  businessId          String
  statementActivityId String
  transactionId       String
  activityVersion     Int
  transactionVersion  Int
  status              String   @default("REJECTED")
  createdAt           DateTime @default(now())

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  statementActivity StatementActivity @relation(fields: [businessId, statementActivityId], references: [businessId, id], onDelete: Restrict)
  transaction       Transaction       @relation("StatementActivityCandidateTransaction", fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, statementActivityId, transactionId, activityVersion, transactionVersion])
  @@index([businessId, statementActivityId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("Session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("Account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("Verification")
}
