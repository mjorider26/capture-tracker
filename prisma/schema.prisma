  priorPayments         Decimal             @default(0) @db.Decimal(18, 2)
  recommendedPayment    Decimal             @db.Decimal(18, 2)
  dueDate               DateTime
  assumptionsJson       Json
  explanation           String
  cpaReviewRecommended  Boolean             @default(false)
  supersedesEstimateId  String?
  revisionNumber        Int                 @default(1)
