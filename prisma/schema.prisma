model QuarterlyTaxEstimate {
  id                    String              @id @default(cuid())
  businessId            String
  taxYear               Int
  quarter               Int
  jurisdictionType      TaxJurisdictionType
  jurisdictionCode      String
  status                TaxEstimateStatus   @default(DRAFT)
  projectedTaxLiability Decimal             @db.Decimal(18, 2)
  safeHarborRequired    Decimal?            @db.Decimal(18, 2)
  withholdingCredits    Decimal             @default(0) @db.Decimal(18, 2)
  priorPayments         Decimal             @default(0) @db.Decimal(18, 2)
  recommendedPayment    Decimal             @db.Decimal(18, 2)
  dueDate               DateTime
  assumptionsJson       Json
  explanation           String
  cpaReviewRecommended  Boolean             @default(false)
  supersedesEstimateId  String?
  revisionNumber        Int                 @default(1)
  approvedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  version               Int                 @default(1)

  business           Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supersedesEstimate QuarterlyTaxEstimate?  @relation("TaxEstimateVersions", fields: [businessId, supersedesEstimateId], references: [businessId, id], onDelete: Restrict)
  supersededBy       QuarterlyTaxEstimate[] @relation("TaxEstimateVersions")
  payments           TaxPaymentRecord[]
  approvals          ApprovalDecision[]     @relation("TaxEstimateApprovals")

  @@unique([businessId, id])
  @@unique([businessId, taxYear, quarter, jurisdictionType, jurisdictionCode, revisionNumber])
  @@unique([businessId, supersedesEstimateId])
  @@index([businessId, dueDate])
  @@index([businessId, status])
}

model TaxPaymentRecord {
  id                 String              @id @default(cuid())
  businessId         String
  estimateId         String?
  jurisdictionType   TaxJurisdictionType
  jurisdictionCode   String
  taxYear            Int
  quarter            Int
  amount             Decimal             @db.Decimal(18, 2)
  status             TaxPaymentStatus    @default(PLANNED)
  paidAt             DateTime?
  idempotencyKey     String?             @db.VarChar(64)
  confirmationNumber String?
  documentId         String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  version            Int                 @default(1)

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  estimate     QuarterlyTaxEstimate? @relation(fields: [businessId, estimateId], references: [businessId, id], onDelete: Restrict)
  document     Document?             @relation("TaxPaymentDocument", fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  journalEntry JournalEntry?         @relation("TaxPaymentJournalEntry")

  @@unique([businessId, id])
  @@unique([businessId, estimateId, idempotencyKey])
  @@index([businessId, taxYear, quarter])
  @@index([businessId, status])
}

model WeeklyReview {
  id                         String       @id @default(cuid())
  businessId                 String
  weekStart                  DateTime
  weekEnd                    DateTime
  status                     ReviewStatus @default(OPEN)
  estimatedCompletionMinutes Int          @default(10)
  startedByUserId            String?
  startedAt                  DateTime?
  completedAt                DateTime?
  completedByUserId          String?
  completionNote             String?
  unresolvedItemCount        Int?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  version                    Int          @default(1)

