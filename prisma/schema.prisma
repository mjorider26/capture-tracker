generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  ADVISOR
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  PERSONAL_CARD
  CASH
}

enum AccountOwnership {
  BUSINESS
  PERSONAL
}

enum TransactionDirection {
  INFLOW
  OUTFLOW
}

enum TransactionIntent {
  UNREVIEWED
  BUSINESS
  PERSONAL
  MIXED
}

enum TransactionStatus {
  PENDING_REVIEW
  APPROVED
  EXCLUDED
  VOIDED
}

enum DocumentType {
  RECEIPT
  BANK_STATEMENT
  CREDIT_CARD_STATEMENT
  PAYROLL_REPORT
  TAX_FORM
  REIMBURSEMENT_SUPPORT
  OTHER
}

enum DocumentStatus {
  PENDING_VALIDATION
  ACTIVE
  QUARANTINED
  REJECTED
  SUPERSEDED
  DELETED
}

enum DocumentCategory {
  RECEIPT
  BANK_STATEMENT
  TAX_DOCUMENT
  PAYROLL_DOCUMENT
  OTHER
}

enum DocumentStorageState {
  METADATA_ONLY
  PENDING_STORAGE
  STORED_PRIVATE
  QUARANTINED_PRIVATE
  STORAGE_FAILED
}

enum TransactionDocumentLinkAction {
  LINKED
  UNLINKED
}

enum DocumentExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  STALE
}

enum DocumentExtractionFieldType {
  MERCHANT_NAME
  DOCUMENT_DATE
  TOTAL_AMOUNT
  SUBTOTAL_AMOUNT
  SALES_TAX_AMOUNT
  TIP_AMOUNT
  REFERENCE_NUMBER
  CURRENCY
  PAYMENT_METHOD
  MASKED_ACCOUNT_REFERENCE
  DOCUMENT_DESCRIPTION
}

enum DocumentExtractionReviewState {
  UNREVIEWED
  ACCEPTED
  CORRECTED
  REJECTED
}

enum DocumentExtractionHistoryAction {
  REQUESTED
  COMPLETED
  FAILED
  STALE
  ACCEPTED
  CORRECTED
  REJECTED
}

enum DocumentMatchRunStatus {
  PROCESSING
  COMPLETED
  FAILED
  STALE
  DISMISSED
}

enum DocumentMatchSuggestionStatus {
  SUGGESTED
  APPROVED
  REJECTED
  DISMISSED
  STALE
}

enum DocumentMatchHistoryAction {
  GENERATED
  APPROVED
  REJECTED
  DISMISSED
  STALE
  LINKED
  LINK_FAILED
}

enum MalwareScanStatus {
  NOT_STARTED
  PENDING
  CLEAN
  INFECTED
  UNSUPPORTED
  FAILED
}

enum RetentionClass {
  GENERAL_TAX_SEVEN_YEARS
  EMPLOYMENT_TAX_FOUR_YEARS
  PERMANENT
  CUSTOM
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  APPROVE
  REJECT
  VOID
  UPLOAD
  VALIDATE
  QUARANTINE
  SUPERSEDE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum LedgerAccountSubtype {
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  OTHER_CURRENT_ASSET
  FIXED_ASSET
  CREDIT_CARD
  ACCOUNTS_PAYABLE
  PAYROLL_TAX_PAYABLE
  REIMBURSEMENT_PAYABLE
  OTHER_CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  OWNER_CONTRIBUTION
  OWNER_DISTRIBUTION
  RETAINED_EARNINGS
  COMMISSION_INCOME
  OTHER_INCOME
  TRAVEL_EXPENSE
  MEALS_EXPENSE
  LODGING_EXPENSE
  MILEAGE_EXPENSE
  PHONE_EXPENSE
  INTERNET_EXPENSE
  OFFICE_SUPPLIES_EXPENSE
  PAYROLL_EXPENSE
  PAYROLL_TAX_EXPENSE
  PROFESSIONAL_FEES_EXPENSE
  OTHER_EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REVERSED
  VOIDED
}

enum JournalEntrySourceType {
  MANUAL
  BANK_TRANSACTION
  REIMBURSEMENT_CLAIM
  REIMBURSEMENT_PAYMENT
  PAYROLL_RUN
  OWNER_DISTRIBUTION
  TAX_PAYMENT
  OPENING_BALANCE
  ADJUSTING_ENTRY
  REVERSING_ENTRY
}

enum AccountingPeriodStatus {
  OPEN
  SOFT_CLOSED
  LOCKED
}

enum ReconciliationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  VOIDED
}

enum ReconciliationItemStatus {
  OUTSTANDING
  CLEARED
  EXCLUDED
}

enum PostingRuleStatus {
  ACTIVE
  INACTIVE
}

enum PostingRuleSourceType {
  TRANSACTION_INTENT
  REIMBURSEMENT_EXPENSE
  PAYROLL_RUN
  OWNER_DISTRIBUTION
  TAX_PAYMENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  displayName   String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  memberships BusinessMember[]
  sessions    Session[]
  accounts    Account[]
}

model Business {
  id                   String   @id @default(cuid())
  legalName            String
  displayName          String
  einLastFour          String?
  taxElection          String   @default("S_CORP")
  fiscalYearStartMonth Int      @default(1)
  timezone             String   @default("America/Los_Angeles")
  currency             String   @default("USD")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  version              Int      @default(1)

  members                    BusinessMember[]
  accounts                   FinancialAccount[]
  transactions               Transaction[]
  documents                  Document[]
  documentStatusHistory      DocumentStatusHistory[]
  transactionDocuments       TransactionDocument[]
  transactionDocumentHistory TransactionDocumentHistory[]
  documentExtractionAttempts DocumentExtractionAttempt[]
  documentExtractionHistory  DocumentExtractionHistory[]
  documentMatchRuns          DocumentMatchRun[]
  documentMatchSuggestions   DocumentMatchSuggestion[]
  documentMatchHistory       DocumentMatchHistory[]
  auditEvents                AuditEvent[]
  reimbursementClaims        ReimbursementClaim[]
  reimbursementExpenses      ReimbursementExpense[]
  payrollRuns                PayrollRun[]
  ownerDistributions         OwnerDistribution[]
  quarterlyTaxEstimates      QuarterlyTaxEstimate[]
  taxPaymentRecords          TaxPaymentRecord[]
  weeklyReviews              WeeklyReview[]
  weeklyReviewHistory        WeeklyReviewHistory[]
  askAiConversations         AskAiConversation[]
  askAiMessages              AskAiMessage[]
  askAiRuns                  AskAiRun[]
  askAiEvidence              AskAiEvidence[]
  askAiFeedback              AskAiFeedback[]
  askAiEvents                AskAiEvent[]
  onboarding                 BusinessOnboarding?
  settings                   BusinessSettings?
  settingsHistory            BusinessSettingsHistory[]
  exportAudits               ExportAudit[]
  aiRecommendations          AIRecommendation[]
  approvalDecisions          ApprovalDecision[]
  ledgerAccounts             LedgerAccount[]
  journalEntries             JournalEntry[]
  journalLines               JournalLine[]
  accountingPeriods          AccountingPeriod[]
  reconciliations            Reconciliation[]
  reconciliationItems        ReconciliationItem[]
  postingRules               PostingRule[]

  @@index([legalName])
}

model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  version    Int          @default(1)

  business                     Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedTransactions         Transaction[]                 @relation("TransactionApproverMembership")
  uploadedDocuments            Document[]                    @relation("DocumentUploaderMembership")
  documentStatusHistory        DocumentStatusHistory[]       @relation("DocumentStatusHistoryActor")
  auditEvents                  AuditEvent[]                  @relation("AuditActorMembership")
  reimbursementClaims          ReimbursementClaim[]          @relation("ReimbursementClaimantMembership")
  approvalDecisions            ApprovalDecision[]            @relation("ApprovalReviewerMembership")
  linkedTransactionDocuments   TransactionDocument[]         @relation("TransactionDocumentLinkedBy")
  unlinkedTransactionDocuments TransactionDocument[]         @relation("TransactionDocumentUnlinkedBy")
  transactionDocumentHistory   TransactionDocumentHistory[]  @relation("TransactionDocumentHistoryActor")
  requestedDocumentExtractions DocumentExtractionAttempt[]   @relation("DocumentExtractionRequestedBy")
  reviewedDocumentCandidates   DocumentExtractionCandidate[] @relation("DocumentExtractionReviewedBy")
  documentExtractionHistory    DocumentExtractionHistory[]   @relation("DocumentExtractionHistoryActor")
  requestedDocumentMatchRuns   DocumentMatchRun[]            @relation("DocumentMatchRequestedBy")
  documentMatchHistory         DocumentMatchHistory[]        @relation("DocumentMatchHistoryActor")
  startedWeeklyReviews         WeeklyReview[]                @relation("WeeklyReviewStartedBy")
  completedWeeklyReviews       WeeklyReview[]                @relation("WeeklyReviewCompletedBy")
  weeklyReviewHistory          WeeklyReviewHistory[]         @relation("WeeklyReviewHistoryActor")
  askAiConversations           AskAiConversation[]           @relation("AskAiConversationActor")
  askAiMessages                AskAiMessage[]                @relation("AskAiMessageActor")
  askAiRuns                    AskAiRun[]                    @relation("AskAiRunActor")
  askAiFeedback                AskAiFeedback[]               @relation("AskAiFeedbackActor")
  askAiEvents                  AskAiEvent[]                  @relation("AskAiEventActor")
  onboardingChanges            BusinessOnboarding[]          @relation("BusinessOnboardingActor")
  settingsChanges              BusinessSettingsHistory[]     @relation("BusinessSettingsHistoryActor")
  exportAudits                 ExportAudit[]                 @relation("ExportAuditActor")

  @@unique([businessId, userId])
  @@index([userId])
}

model FinancialAccount {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  institutionName String?
  type            AccountType
  ownership       AccountOwnership
  lastFour        String?
  isTaxReserve    Boolean          @default(false)
  isActive        Boolean          @default(true)
  openingBalance  Decimal          @default(0) @db.Decimal(18, 2)
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  version         Int              @default(1)

  business                   Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transactions               Transaction[]
  reimbursementAccounts      ReimbursementClaim[] @relation("ReimbursementPaymentAccount")
  distributionSourceAccounts OwnerDistribution[]  @relation("DistributionSourceAccount")
  ledgerAccount              LedgerAccount?       @relation("FinancialAccountLedgerAccount")
  reconciliations            Reconciliation[]

  @@unique([businessId, id])
  @@index([businessId, isActive])
  @@index([businessId, type])
}

model Transaction {
  id                     String               @id @default(cuid())
  businessId             String
  accountId              String
  postedAt               DateTime
  description            String
  merchantName           String?
  amount                 Decimal              @db.Decimal(18, 2)
  direction              TransactionDirection
  intent                 TransactionIntent    @default(UNREVIEWED)
  status                 TransactionStatus    @default(PENDING_REVIEW)
  sourceReference        String?
  notes                  String?
  approvedAt             DateTime?
  approvedByMembershipId String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  voidedAt               DateTime?
  version                Int                  @default(1)

  business              Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account               FinancialAccount          @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)
  approvedByMembership  BusinessMember?           @relation("TransactionApproverMembership", fields: [businessId, approvedByMembershipId], references: [businessId, userId], onDelete: Restrict)
  splits                TransactionSplit[]
  documents             TransactionDocument[]
  matchSuggestions      DocumentMatchSuggestion[]
  reimbursementPayments ReimbursementClaim[]      @relation("ReimbursementPaymentTransaction")
  reimbursementExpenses ReimbursementExpense[]    @relation("ReimbursementExpenseTransaction")
  distributions         OwnerDistribution[]       @relation("DistributionTransaction")
  journalEntry          JournalEntry?             @relation("TransactionJournalEntry")
  reconciliationItems   ReconciliationItem[]

  @@unique([businessId, id])
  @@unique([accountId, sourceReference])
  @@index([businessId, postedAt])
  @@index([businessId, status])
  @@index([businessId, intent])
  @@index([businessId, accountId, postedAt])
}

model TransactionSplit {
  id            String            @id @default(cuid())
  businessId    String
  transactionId String
  intent        TransactionIntent
  amount        Decimal           @db.Decimal(18, 2)
  memo          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  version       Int               @default(1)

  transaction Transaction @relation(fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, transactionId])
}

model Document {
  id                     String               @id @default(cuid())
  businessId             String
  uploadedByMembershipId String
  storageKey             String?              @unique
  originalFilename       String
  displayName            String
  mimeType               String
  detectedMimeType       String?
  sizeBytes              BigInt
  sha256                 String
  type                   DocumentType
  category               DocumentCategory
  status                 DocumentStatus       @default(PENDING_VALIDATION)
  storageState           DocumentStorageState @default(METADATA_ONLY)
  storageProvider        String?
  storedSizeBytes        BigInt?
  objectVersion          String?
  uploadCompletedAt      DateTime?
  privateReadEligible    Boolean              @default(false)
  documentDate           DateTime?
  quarantineReasonCode   String?
  quarantineExplanation  String?
  malwareScanStatus      MalwareScanStatus    @default(NOT_STARTED)
  malwareScanProvider    String?
  malwareScannedAt       DateTime?
  validationError        String?
  retentionClass         RetentionClass
  retentionUntil         DateTime
  legalHold              Boolean              @default(false)
  uploadedAt             DateTime             @default(now())
  activatedAt            DateTime?
  supersededAt           DateTime?
  deletedAt              DateTime?
  replacedById           String?
  version                Int                  @default(1)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  business              Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  uploadedByMembership  BusinessMember              @relation("DocumentUploaderMembership", fields: [businessId, uploadedByMembershipId], references: [businessId, userId], onDelete: Restrict)
  replacedBy            Document?                   @relation("DocumentVersions", fields: [businessId, replacedById], references: [businessId, id], onDelete: Restrict)
  previousVersions      Document[]                  @relation("DocumentVersions")
  transactions          TransactionDocument[]
  reimbursementExpenses ReimbursementExpense[]      @relation("ReimbursementExpenseDocument")
  payrollRuns           PayrollRun[]                @relation("PayrollRunDocument")
  taxPayments           TaxPaymentRecord[]          @relation("TaxPaymentDocument")
  statusHistory         DocumentStatusHistory[]
  extractionAttempts    DocumentExtractionAttempt[]
  matchRuns             DocumentMatchRun[]

  @@unique([businessId, id])
  @@unique([businessId, replacedById])
  @@unique([businessId, sha256])
  @@index([businessId, sha256])
  @@index([businessId, status])
  @@index([businessId, type])
  @@index([retentionUntil])
  @@index([malwareScanStatus])
}

model DocumentStatusHistory {
  id             String          @id @default(cuid())
  businessId     String
  documentId     String
  previousStatus DocumentStatus?
  newStatus      DocumentStatus
  reasonCode     String?
  note           String?
  actorUserId    String
  createdAt      DateTime        @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  document Document       @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  actor    BusinessMember @relation("DocumentStatusHistoryActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, documentId, createdAt])
}

model TransactionDocument {
  id               String    @id @default(cuid())
  businessId       String
  transactionId    String
  documentId       String
  attachedAt       DateTime  @default(now())
  linkedByUserId   String
  unlinkedAt       DateTime?
  unlinkedByUserId String?
  unlinkReason     String?
  version          Int       @default(1)

  business    Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transaction Transaction                  @relation(fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)
  document    Document                     @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  linkedBy    BusinessMember               @relation("TransactionDocumentLinkedBy", fields: [businessId, linkedByUserId], references: [businessId, userId], onDelete: Restrict)
  unlinkedBy  BusinessMember?              @relation("TransactionDocumentUnlinkedBy", fields: [businessId, unlinkedByUserId], references: [businessId, userId], onDelete: Restrict)
  history     TransactionDocumentHistory[]

  @@unique([businessId, id])
  @@index([businessId, transactionId, attachedAt])
  @@index([businessId, documentId, attachedAt])
}

model TransactionDocumentHistory {
  id                    String                        @id @default(cuid())
  businessId            String
  transactionDocumentId String
  action                TransactionDocumentLinkAction
  actorUserId           String
  note                  String?
  createdAt             DateTime                      @default(now())

  business Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  link     TransactionDocument @relation(fields: [businessId, transactionDocumentId], references: [businessId, id], onDelete: Restrict)
  actor    BusinessMember      @relation("TransactionDocumentHistoryActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, transactionDocumentId, createdAt])
}

model DocumentExtractionAttempt {
  id                  String                   @id @default(cuid())
  businessId          String
  documentId          String
  sourceSha256        String
  sourceObjectVersion String?
  adapterId           String
  adapterVersion      String
  status              DocumentExtractionStatus @default(PENDING)
  requestedByUserId   String
  requestedAt         DateTime                 @default(now())
  completedAt         DateTime?
  failureCode         String?
  pageCount           Int?
  createdAt           DateTime                 @default(now())

  business    Business                      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  document    Document                      @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  requestedBy BusinessMember                @relation("DocumentExtractionRequestedBy", fields: [businessId, requestedByUserId], references: [businessId, userId], onDelete: Restrict)
  candidates  DocumentExtractionCandidate[]
  history     DocumentExtractionHistory[]
  matchRuns   DocumentMatchRun[]

  @@unique([businessId, id])
  @@index([businessId, documentId, requestedAt])
}

model DocumentExtractionCandidate {
  id                  String                        @id @default(cuid())
  businessId          String
  extractionAttemptId String
  fieldType           DocumentExtractionFieldType
  originalValue       String
  normalizedValue     String?
  confidence          Decimal                       @db.Decimal(5, 4)
  pageNumber          Int?
  sourceReference     String?
  reviewState         DocumentExtractionReviewState @default(UNREVIEWED)
  correctedValue      String?
  reviewedByUserId    String?
  reviewedAt          DateTime?
  createdAt           DateTime                      @default(now())

  attempt    DocumentExtractionAttempt   @relation(fields: [businessId, extractionAttemptId], references: [businessId, id], onDelete: Restrict)
  reviewedBy BusinessMember?             @relation("DocumentExtractionReviewedBy", fields: [businessId, reviewedByUserId], references: [businessId, userId], onDelete: Restrict)
  history    DocumentExtractionHistory[]

  @@unique([businessId, id])
  @@index([businessId, extractionAttemptId, fieldType])
}

model DocumentMatchRun {
  id                    String                 @id @default(cuid())
  businessId            String
  documentId            String
  extractionAttemptId   String
  sourceSha256          String
  sourceObjectVersion   String?
  evidenceFingerprint   String
  matchingEngineId      String
  matchingEngineVersion String
  status                DocumentMatchRunStatus @default(PROCESSING)
  requestedByUserId     String
  requestedAt           DateTime               @default(now())
  completedAt           DateTime?
  failureCode           String?
  createdAt             DateTime               @default(now())

  business    Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  document    Document                  @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  extraction  DocumentExtractionAttempt @relation(fields: [businessId, extractionAttemptId], references: [businessId, id], onDelete: Restrict)
  requestedBy BusinessMember            @relation("DocumentMatchRequestedBy", fields: [businessId, requestedByUserId], references: [businessId, userId], onDelete: Restrict)
  suggestions DocumentMatchSuggestion[]
  history     DocumentMatchHistory[]

  @@unique([businessId, id])
  @@index([businessId, documentId, requestedAt])
  @@index([businessId, extractionAttemptId])
}

model DocumentMatchSuggestion {
  id                  String                        @id @default(cuid())
  businessId          String
  runId               String
  transactionId       String
  score               Int
  reasonCodes         Json
  rank                Int
  status              DocumentMatchSuggestionStatus @default(SUGGESTED)
  transactionAmount   Decimal                       @db.Decimal(18, 2)
  transactionPostedAt DateTime
  transactionVersion  Int
  createdAt           DateTime                      @default(now())
  decidedAt           DateTime?

  business    Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  run         DocumentMatchRun       @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)
  transaction Transaction            @relation(fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)
  history     DocumentMatchHistory[]

  @@unique([businessId, id])
  @@unique([businessId, runId, transactionId])
  @@index([businessId, transactionId, createdAt])
}

model DocumentMatchHistory {
  id           String                     @id @default(cuid())
  businessId   String
  runId        String
  suggestionId String?
  action       DocumentMatchHistoryAction
  actorUserId  String
  note         String?
  createdAt    DateTime                   @default(now())

  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  run        DocumentMatchRun         @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)
  suggestion DocumentMatchSuggestion? @relation(fields: [businessId, suggestionId], references: [businessId, id], onDelete: Restrict)
  actor      BusinessMember           @relation("DocumentMatchHistoryActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, runId, createdAt])
  @@index([businessId, suggestionId, createdAt])
}

model DocumentExtractionHistory {
  id                  String                          @id @default(cuid())
  businessId          String
  extractionAttemptId String
  candidateId         String?
  action              DocumentExtractionHistoryAction
  actorUserId         String
  note                String?
  createdAt           DateTime                        @default(now())

  business  Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  attempt   DocumentExtractionAttempt    @relation(fields: [businessId, extractionAttemptId], references: [businessId, id], onDelete: Restrict)
  candidate DocumentExtractionCandidate? @relation(fields: [businessId, candidateId], references: [businessId, id], onDelete: Restrict)
  actor     BusinessMember               @relation("DocumentExtractionHistoryActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, extractionAttemptId, createdAt])
}

/// USER events require a membership; SYSTEM events must not reference one.
model AuditEvent {
  actorType         AuditActorType @default(USER)
  id                String         @id @default(cuid())
  businessId        String
  actorMembershipId String?
  action            AuditAction
  entityType        String
  entityId          String
  reason            String?
  beforeJson        Json?
  afterJson         Json?
  metadataJson      Json?
  occurredAt        DateTime       @default(now())

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actorMembership BusinessMember? @relation("AuditActorMembership", fields: [businessId, actorMembershipId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, occurredAt])
  @@index([businessId, entityType, entityId])
  @@index([actorMembershipId, occurredAt])
}

enum ReimbursementStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  PAID
  VOIDED
}

enum ReimbursementExpenseType {
  MILEAGE
  AIRFARE
  LODGING
  MEALS
  PARKING
  TOLLS
  SUPPLIES
  PHONE
  INTERNET
  EDUCATION
  OTHER
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  VOIDED
}

enum DistributionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  VOIDED
}

enum TaxEstimateStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SUPERSEDED
  VOIDED
}

enum TaxPaymentStatus {
  PLANNED
  RECORDED
  VOIDED
}

enum TaxJurisdictionType {
  FEDERAL
  STATE
  LOCAL
}

enum ReviewStatus {
  OPEN
  COMPLETED
  DISMISSED
}

enum WeeklyReviewHistoryAction {
  STARTED
  SECTION_ACKNOWLEDGED
  COMPLETED
  REOPENED
}

enum AskAiMessageRole {
  USER
  ASSISTANT
  SYSTEM_EVENT
}

enum AskAiRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  BLOCKED
}

enum AskAiEventAction {
  QUESTION_SUBMITTED
  CONTEXT_PREPARED
  ADAPTER_INVOKED
  ANSWER_COMPLETED
  ANSWER_FAILED
  ANSWER_BLOCKED
  ANSWER_REFRESHED
  FEEDBACK_RECORDED
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
}

enum ExportKind {
