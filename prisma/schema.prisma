model ReimbursementClaim {
  id                     String              @id @default(cuid())
  businessId             String
  claimantMembershipId   String
  status                 ReimbursementStatus @default(DRAFT)
  submittedAt            DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  paidAt                 DateTime?
  totalAmount            Decimal             @default(0) @db.Decimal(18, 2)
  reimbursementAccountId String?
  paymentTransactionId   String?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  version                Int                 @default(1)

  business             Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  claimantMembership   BusinessMember         @relation("ReimbursementClaimantMembership", fields: [businessId, claimantMembershipId], references: [businessId, userId], onDelete: Restrict)
  reimbursementAccount FinancialAccount?      @relation("ReimbursementPaymentAccount", fields: [businessId, reimbursementAccountId], references: [businessId, id], onDelete: Restrict)
  paymentTransaction   Transaction?           @relation("ReimbursementPaymentTransaction", fields: [businessId, paymentTransactionId], references: [businessId, id], onDelete: Restrict)
  expenses             ReimbursementExpense[]
  approvals            ApprovalDecision[]     @relation("ReimbursementApprovals")
  journalEntry         JournalEntry?          @relation("ReimbursementClaimJournalEntry")

  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, submittedAt])
}

model ReimbursementExpense {
  id              String                   @id @default(cuid())
  businessId      String
  claimId         String
  expenseType     ReimbursementExpenseType
  transactionId   String?
  documentId      String?
  incurredAt      DateTime
  amount          Decimal                  @db.Decimal(18, 2)
  businessPurpose String
  merchantName    String?
  attendees       String?
  tripOrigin      String?
  tripDestination String?
  mileageMiles    Decimal?                 @db.Decimal(10, 2)
  mileageRate     Decimal?                 @db.Decimal(8, 4)
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  version         Int                      @default(1)

  claim       ReimbursementClaim @relation(fields: [businessId, claimId], references: [businessId, id], onDelete: Restrict)
  transaction Transaction?       @relation("ReimbursementExpenseTransaction", fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)
  document    Document?          @relation("ReimbursementExpenseDocument", fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  business    Business           @relation(fields: [businessId], references: [id])

  @@unique([businessId, id])
  @@index([businessId, claimId])
  @@index([businessId, transactionId])
  @@index([businessId, documentId])
}

model PayrollRun {
  id                  String           @id @default(cuid())
  businessId          String
  payPeriodStart      DateTime
  payPeriodEnd        DateTime
  payDate             DateTime
  status              PayrollRunStatus @default(DRAFT)
  grossWages          Decimal          @db.Decimal(18, 2)
  employeeWithholding Decimal          @db.Decimal(18, 2)
  employeePayrollTax  Decimal          @db.Decimal(18, 2)
  otherDeductions     Decimal          @default(0) @db.Decimal(18, 2)
  employerPayrollTax  Decimal          @db.Decimal(18, 2)
  netPay              Decimal          @db.Decimal(18, 2)
  payrollProvider     String?
  externalReference   String?
  documentId          String?
  approvedAt          DateTime?
  processedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  version             Int              @default(1)

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  document     Document?          @relation("PayrollRunDocument", fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  approvals    ApprovalDecision[] @relation("PayrollApprovals")
  journalEntry JournalEntry?      @relation("PayrollRunJournalEntry")

  @@unique([businessId, id])
  @@unique([businessId, externalReference])
  @@index([businessId, payDate])
  @@index([businessId, status])
}

model OwnerDistribution {
  id               String             @id @default(cuid())
  businessId       String
  distributionDate DateTime
  amount           Decimal            @db.Decimal(18, 2)
  status           DistributionStatus @default(DRAFT)
  sourceAccountId  String
  transactionId    String?
  memo             String?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  version          Int                @default(1)

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceAccount FinancialAccount   @relation("DistributionSourceAccount", fields: [businessId, sourceAccountId], references: [businessId, id], onDelete: Restrict)
  transaction   Transaction?       @relation("DistributionTransaction", fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)
  approvals     ApprovalDecision[] @relation("DistributionApprovals")
  journalEntry  JournalEntry?      @relation("OwnerDistributionJournalEntry")

  @@unique([businessId, id])
  @@index([businessId, distributionDate])
