  @@unique([businessId, id])
  @@unique([businessId, startsAt, endsAt])
  @@index([businessId, status])
}

model JournalEntry {
  id                     String                 @id @default(cuid())
  businessId             String
  accountingPeriodId     String
  entryNumber            String
  entryDate              DateTime
  description            String
  status                 JournalEntryStatus     @default(DRAFT)
  sourceType             JournalEntrySourceType
  sourceEntityId         String?
  transactionId          String?
  reimbursementClaimId   String?
  payrollRunId           String?
  ownerDistributionId    String?
  taxPaymentRecordId     String?
  reversalOfEntryId      String?
  postedAt               DateTime?
  reversedAt             DateTime?
  approvedByMembershipId String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  version                Int                    @default(1)

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  accountingPeriod   AccountingPeriod    @relation(fields: [businessId, accountingPeriodId], references: [businessId, id], onDelete: Restrict)
  transaction        Transaction?        @relation("TransactionJournalEntry", fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)
  reimbursementClaim ReimbursementClaim? @relation("ReimbursementClaimJournalEntry", fields: [businessId, reimbursementClaimId], references: [businessId, id], onDelete: Restrict)
  payrollRun         PayrollRun?         @relation("PayrollRunJournalEntry", fields: [businessId, payrollRunId], references: [businessId, id], onDelete: Restrict)
  ownerDistribution  OwnerDistribution?  @relation("OwnerDistributionJournalEntry", fields: [businessId, ownerDistributionId], references: [businessId, id], onDelete: Restrict)
  taxPaymentRecord   TaxPaymentRecord?   @relation("TaxPaymentJournalEntry", fields: [businessId, taxPaymentRecordId], references: [businessId, id], onDelete: Restrict)
  reversalOfEntry    JournalEntry?       @relation("JournalEntryReversals", fields: [businessId, reversalOfEntryId], references: [businessId, id], onDelete: Restrict)
  reversedByEntries  JournalEntry[]      @relation("JournalEntryReversals")
  lines              JournalLine[]

  @@unique([businessId, id])
  @@unique([businessId, entryNumber])
  @@unique([businessId, transactionId])
  @@unique([businessId, reimbursementClaimId])
  @@unique([businessId, payrollRunId])
  @@unique([businessId, ownerDistributionId])
  @@unique([businessId, taxPaymentRecordId])
  @@unique([businessId, reversalOfEntryId])
  @@index([businessId, entryDate])
  @@index([businessId, status])
  @@index([businessId, sourceType, sourceEntityId])
}

model JournalLine {
  id              String   @id @default(cuid())
  businessId      String
  journalEntryId  String
  ledgerAccountId String
  lineNumber      Int
  memo            String?
  debitAmount     Decimal  @default(0) @db.Decimal(18, 2)
  creditAmount    Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry  @relation(fields: [businessId, journalEntryId], references: [businessId, id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [businessId, ledgerAccountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, journalEntryId, lineNumber])
  @@index([businessId, ledgerAccountId])
}

model PostingRule {
  id                    String                @id @default(cuid())
  businessId            String
  name                  String
  status                PostingRuleStatus     @default(ACTIVE)
  sourceType            PostingRuleSourceType
  sourceSubtype         String?
  debitLedgerAccountId  String
  creditLedgerAccountId String
  priority              Int                   @default(100)
  description           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  version               Int                   @default(1)

  business            Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  debitLedgerAccount  LedgerAccount @relation("PostingRuleDebitAccount", fields: [businessId, debitLedgerAccountId], references: [businessId, id], onDelete: Restrict)
  creditLedgerAccount LedgerAccount @relation("PostingRuleCreditAccount", fields: [businessId, creditLedgerAccountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, sourceType, sourceSubtype, priority])
  @@index([businessId, status])
}

model Reconciliation {
  id                      String               @id @default(cuid())
  businessId              String
  financialAccountId      String
  statementStartDate      DateTime
  statementEndDate        DateTime
  statementOpeningBalance Decimal              @db.Decimal(18, 2)
  statementEndingBalance  Decimal              @db.Decimal(18, 2)
  status                  ReconciliationStatus @default(DRAFT)
  completedAt             DateTime?
  completedByMembershipId String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  version                 Int                  @default(1)

  business         Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccount FinancialAccount     @relation(fields: [businessId, financialAccountId], references: [businessId, id], onDelete: Restrict)
  items            ReconciliationItem[]

  @@unique([businessId, id])
  @@unique([businessId, financialAccountId, statementEndDate])
  @@index([businessId, status])
}

model ReconciliationItem {
  id               String                   @id @default(cuid())
  businessId       String
  reconciliationId String
  transactionId    String
  status           ReconciliationItemStatus @default(OUTSTANDING)
  clearedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  version          Int                      @default(1)

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reconciliation Reconciliation @relation(fields: [businessId, reconciliationId], references: [businessId, id], onDelete: Restrict)
  transaction    Transaction    @relation(fields: [businessId, transactionId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, reconciliationId, transactionId])
  @@index([businessId, status])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("Session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("Account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("Verification")
}
