/// Provider-neutral connection metadata. Provider credentials are held only by the provider,
/// never persisted in Capture Tracker.
model BankConnection {
  id                 String              @id @default(cuid())
  businessId         String
  providerId         String              @db.VarChar(64)
  providerConnectionRef String            @db.VarChar(191)
  institutionName    String?             @db.VarChar(180)
  state              BankConnectionState @default(CONNECTED)
  lastSuccessfulSyncAt DateTime?
  lastAttemptedSyncAt DateTime?
  syncCursor         String?             @db.VarChar(500)
  errorCode          String?             @db.VarChar(100)
  errorMessage       String?             @db.VarChar(500)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  version            Int                 @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  accounts ConnectedFinancialAccount[]
  syncRuns BankSyncRun[]
  providerTransactions BankProviderTransaction[]

  @@unique([businessId, providerId, providerConnectionRef])
  @@index([businessId, state])
}

/// Explicitly maps a provider account to the existing Capture Tracker financial account.
model ConnectedFinancialAccount {
  id                 String @id @default(cuid())
  businessId         String
  bankConnectionId   String
  financialAccountId String?
  externalAccountRef String @db.VarChar(191)
  name               String @db.VarChar(180)
  accountType        String @db.VarChar(64)
  maskedLastFour     String? @db.VarChar(4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  version            Int @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Restrict)
  financialAccount FinancialAccount? @relation(fields: [businessId, financialAccountId], references: [businessId, id], onDelete: Restrict)
  providerTransactions BankProviderTransaction[]

  @@unique([businessId, bankConnectionId, externalAccountRef])
  @@index([businessId, financialAccountId])
}

model BankSyncRun {
  id               String @id @default(cuid())
  businessId       String
  bankConnectionId String
  status           BankSyncStatus @default(STARTED)
  cursorBefore     String? @db.VarChar(500)
  cursorAfter      String? @db.VarChar(500)
  importedCount    Int @default(0)
  duplicateCount   Int @default(0)
  updatedCount     Int @default(0)
  errorCode        String? @db.VarChar(100)
  errorMessage     String? @db.VarChar(500)
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Restrict)
  providerTransactions BankProviderTransaction[]

  @@index([businessId, bankConnectionId, startedAt])
}

/// Provider-delivery evidence. It is normalized before an ExternalTransaction is created.
model BankProviderTransaction {
  id                         String @id @default(cuid())
  businessId                 String
  bankConnectionId           String
  connectedFinancialAccountId String
  bankSyncRunId              String?
  providerTransactionRef     String @db.VarChar(191)
  transactionDate            DateTime
  postedDate                 DateTime?
  description                String
  amount                     Decimal @db.Decimal(18, 2)
  direction                  TransactionDirection
  pending                    Boolean @default(false)
  providerUpdatedAt          DateTime?
  normalizedExternalTransactionId String? @unique
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  version                    Int @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Restrict)
  account ConnectedFinancialAccount @relation(fields: [connectedFinancialAccountId], references: [id], onDelete: Restrict)
  syncRun BankSyncRun? @relation(fields: [bankSyncRunId], references: [id], onDelete: Restrict)

  @@unique([businessId, bankConnectionId, providerTransactionRef])
  @@index([businessId, connectedFinancialAccountId, transactionDate])
}

model Customer {
