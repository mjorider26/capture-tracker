/// Each match is explicit evidence, not a conclusion drawn from a bank description.
model PayrollBankMatch {
  id                    String             @id @default(cuid())
  businessId            String
  payrollRunId          String
  externalTransactionId String
  kind                  String             @db.VarChar(32)
  expectedAmount        Decimal            @db.Decimal(18, 2)
  matchedAmount         Decimal            @db.Decimal(18, 2)
  status                PayrollMatchStatus @default(UNMATCHED)
  notes                 String?
  matchedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  version               Int                @default(1)

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payrollRun          PayrollRun          @relation(fields: [businessId, payrollRunId], references: [businessId, id], onDelete: Restrict)
  externalTransaction ExternalTransaction @relation(fields: [businessId, externalTransactionId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, payrollRunId, externalTransactionId, kind])
  @@index([businessId, status])
}

