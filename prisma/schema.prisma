  explanation         String
  proposedChangeJson  Json
  supportingFactsJson Json?
  modelProvider       String
  modelName           String
  promptVersion       String
  expiresAt           DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  version             Int                    @default(1)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  approvals ApprovalDecision[] @relation("AIRecommendationApprovals")

  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, type])
  @@index([businessId, sourceEntityType, sourceEntityId])
