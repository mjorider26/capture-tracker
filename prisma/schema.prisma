  createdAt   DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  run      AskAiRun       @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)
  actor    BusinessMember @relation("AskAiFeedbackActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, runId, actorUserId])
}

model AskAiEvent {
  id          String           @id @default(cuid())
  businessId  String
  runId       String
  actorUserId String
  action      AskAiEventAction
  detail      String?          @db.VarChar(300)
  createdAt   DateTime         @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  run      AskAiRun       @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)
  actor    BusinessMember @relation("AskAiEventActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, runId, createdAt])
}

model BusinessOnboarding {
